{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-commit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/skill-announce-reminder.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Skill(backlog)",
      "Skill(continue)",
      "Skill(deploy)",
      "Skill(design)",
      "Skill(discovery)",
      "Skill(handoff)",
      "Skill(implement)",
      "Skill(pdf)",

      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build *)",
      "Bash(pnpm verify *)",
      "Bash(pnpm format *)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm knip *)",
      "Bash(pnpm env:check *)",
      "Bash(pnpm analyze *)",

      "Bash(pnpm dev)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm run *)",

      "Bash(pnpm db:query *)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm db:seed *)",
      "Bash(pnpm invite:admin *)",

      "Bash(npx -y md-to-pdf@5.2.5 *)",
      "Bash(node .claude/skills/fx-pdf-export/scripts/build-pdf.mjs *)",

      "Bash(pnpm update-board *)",
      "Bash(pnpm board:status)",
      "Bash(pnpm board:status *)",
      "Bash(pnpm skill:lint)",
      "Bash(pnpm skill:lint *)",
      "Bash(pnpm generate:inventory *)",
      "Bash(pnpm generate:codebase *)",
      "Bash(pnpm generate:hooks *)",
      "Bash(pnpm generate:schema *)",
      "Bash(pnpm generate:api *)",
      "Bash(pnpm test:scr-classifier)",
      "Bash(pnpm test:scr-classifier *)",

      "Bash(git add [a-zA-Z0-9._/-]*)",
      "Bash(git commit -m *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git cherry-pick *)",
      "Bash(git rebase *)",
      "Bash(git merge --no-commit --no-ff *)",
      "Bash(git merge --abort)",
      "Bash(git tag *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git remote *)",
      "Bash(git worktree *)",
      "Bash(git reflog *)",
      "Bash(git describe *)",
      "Bash(git mv *)",

      "Bash(gh api *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",

      "Bash(date -u *)",
      "Bash(date +*)",
      "Bash(date)",
      "Bash(mkdir -p .claude/transitions/*)",
      "Bash(mkdir -p .claude/transitions/**)",
      "Bash(mkdir -p .claude/**)",
