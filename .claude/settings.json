      "Bash(rm -rf project/*-artifacts)",
      "Bash(rm -rf project/*-artifacts/*)",
      "Bash(rm -rf \"project/*-artifacts/*\")",

      "Bash(npx @timekast/factory *)",
      "Bash(pnpm dlx @timekast/factory *)",

      "Edit(.claude/**)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(project/**)",
      "Edit(scripts/**)",
      "Edit(public/**)",
      "Edit(.env.example)",

      "Read(//private/tmp/**)",
      "Read(.claude/transitions/*)",
      "Read(.claude/transitions/*/*)",
      "Read(.claude/transitions/**)",
      "Edit(.claude/transitions/*)",
      "Edit(.claude/transitions/*/*)",
      "Edit(.claude/transitions/**)"
