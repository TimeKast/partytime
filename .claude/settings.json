    "ask": [
      "Bash(pnpm install*)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(git stash *)",
      "Edit(.env.local*)"
    ],
    "deny": [
      "Bash(* --no-verify)",
      "Bash(* --no-gpg-sign*)",
      "Bash(pnpm db:push *)",
      "Bash(pnpm run db:push*)",
      "Bash(vercel pull*)",
      "Bash(vercel env pull*)",
      "Bash(vercel link*)",
      "Bash(*> .env.local*)",
      "Bash(*>.env.local*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git reset --hard *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(sed -i *)",
      "Bash(gh api -X POST*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api -X DELETE*)",
