{
  "name": "rooftop-party-invitation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/tools/with-vault.mjs next dev",
    "build": "node scripts/tools/with-vault.mjs next build",
    "start": "node scripts/tools/with-vault.mjs next start",
    "lint": "next lint",
    "test": "vitest run",
    "verify:db": "node --import tsx scripts/verify-db-contract.ts",
    "rehearse:rsvp-invitation": "node --import tsx scripts/rehearse-rsvp-invitation.ts",
    "test:db:capacity-semantics": "bash scripts/test-capacity-function-semantics.sh",
    "db:preflight": "node --import tsx scripts/migration-preflight.ts",
    "db:generate": "node scripts/tools/with-vault.mjs drizzle-kit generate",
    "db:studio": "node scripts/tools/with-vault.mjs drizzle-kit studio",
    "factory:update": "npx @timekast/factory update",
    "factory:doctor": "npx @timekast/factory doctor",
    "factory:status": "npx @timekast/factory status",
    "factory:publish": "npx @timekast/factory publish",
    "factory:unpublish": "npx @timekast/factory unpublish",
    "env:push": "npx @timekast/factory env push",
    "preflight": "tsx scripts/tools/preflight.ts",
    "invite:admin": "npx @timekast/factory invite-admin",
    "setup:e2e:vars": "node scripts/tools/with-vault.mjs --vault-env=develop tsx scripts/tools/setup-e2e.ts --publish-vars",
    "e2e:setup": "playwright install chromium",
    "evidence:visual": "pnpm test:e2e --project=evidence",
    "generate:inventory": "tsx scripts/tools/generate-inventory.ts",
    "generate:codebase": "tsx scripts/tools/generate-codebase.ts",
    "generate:hooks": "tsx scripts/tools/generate-hooks.ts",
    "generate:schema": "tsx scripts/tools/generate-schema.ts",
    "generate:api": "tsx scripts/tools/generate-api.ts",
    "generate:reference": "tsx scripts/tools/generate-inventory.ts && tsx scripts/tools/generate-codebase.ts && tsx scripts/tools/generate-hooks.ts && tsx scripts/tools/generate-schema.ts && tsx scripts/tools/generate-api.ts",
    "verify": "node scripts/tools/verify.mjs",
    "verify:quick": "node scripts/tools/verify.mjs --quick",
    "dev:next": "NODE_OPTIONS='--max-old-space-size=4096' next dev --turbopack",
    "typecheck": "tsc --noEmit",
    "prepare": "husky && git config --unset-all core.hooksPath 2>/dev/null; git config --worktree core.hooksPath .husky/_",
    "skill:lint": "tsx scripts/tools/skill-lint/index.ts",
    "update-board": "tsx scripts/tools/update-board.ts",
    "knip": "knip"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "2.2.13",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "firebase-admin": "^12.7.0",
    "framer-motion": "^11.18.2",
    "image-size": "^2.0.4",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.8",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-international-phone": "^4.8.0",
    "resend": "^6.30.0",
    "sharp": "^0.34.5",
    "stripe": "^22.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "next-auth": "^4.24.15",
    "prettier": "^3.9.9",
    "sonner": "^1.7.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  },
  "packageManager": "pnpm@10.24.0",
  "agentKitVersion": "13.5.0"
}
