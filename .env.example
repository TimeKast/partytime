# Archivo de configuración de variables de entorno
# Copia este archivo como .env.local y actualiza los valores

# ===========================================
# BASE DE DATOS (REQUERIDO)
# ===========================================
# Conexión a Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ===========================================
# AUTENTICACIÓN ADMIN (REQUERIDO)
# ===========================================
# Super admin vía env vars (fallback si el usuario no existe en la tabla `users`).
# ADMIN_EMAIL tiene prioridad sobre ADMIN_USERNAME como identificador de login.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# ===========================================
# EMAIL - RESEND (REQUERIDO)
# ===========================================
# Requerido para enviar confirmaciones/recordatorios. Sin esta key el envío
# falla en runtime (el build ya NO se rompe: lib/resend.ts instancia el cliente
# de forma lazy). Obtén tu API key en https://resend.com
RESEND_API_KEY=re_your_api_key
# Remitente verificado en Resend. Sin él cae al sandbox onboarding@resend.dev.
FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# SEGURIDAD (REQUERIDO)
# ===========================================
# Secret aleatorio para tokens de cancelación de RSVP.
# Genera uno con: openssl rand -hex 32
CANCEL_TOKEN_SECRET=generate-a-random-string-here
# Keyring dedicado para reconstruir links RSVP emitidos sin guardar el bearer.
# El primer key es el activo; conserva keys anteriores al rotar.
# Genera cada secreto con: openssl rand -hex 32
RSVP_INVITATION_TOKEN_KEYS=v1:replace-with-64-hex-characters
# Secret que protege el endpoint del cron (/api/cron/send-reminders).
# Vercel Cron envía automáticamente `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=generate-a-random-string-here
# Opcional (opt-out). El cron ENVÍA por default. Ponlo en 'false' para forzar un
# DRY-RUN (reporta a quién enviaría sin enviar ni marcar) — útil para verificar
# un cambio de lógica de reminders antes de habilitar el envío real.
# REMINDERS_SEND_ENABLED=false

# ===========================================
# PAGOS - STRIPE (OPCIONAL — solo eventos con cobro)
# ===========================================
# Sin estas keys el cliente Stripe queda lazy/sin configurar (ver lib/stripe.ts):
# el build y la suite nunca truenan, pero cualquier cobro real falla en runtime.
# Server-side only: NUNCA NEXT_PUBLIC_STRIPE_* (Checkout es hosted por redirect,
# cero Stripe.js en el frontend — ver PLAN-EPICS-002-005.md §3.3).
# Secret key de tu cuenta de Stripe: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Signing secret del webhook (POST /api/webhooks/stripe, ISSUE-012). Crea el
# endpoint en https://dashboard.stripe.com/webhooks apuntando a
# https://{tu-dominio}/api/webhooks/stripe con estos 4 event types:
#   checkout.session.completed, checkout.session.async_payment_succeeded,
#   checkout.session.expired, charge.refunded
# y pega el `whsec_...` que Stripe genera. Para dev local, en vez de crear un
# endpoint en el dashboard usa la Stripe CLI (imprime su propio whsec_ efímero):
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Ver docs/SETUP_GUIDE.md para el detalle completo.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ===========================================
# PORTAL DE CHECK-IN (OPCIONAL — solo eventos con check-in habilitado)
# ===========================================
# Secret que firma las cookies de sesión del portal /checkin/[slug] (ISSUE-015).
# Sin esta key /api/checkin/auth responde 503 (fail-closed, nunca un secret
# por default) y ninguna sesión de staff puede emitirse. Formato: 64 hex chars.
# Genera uno con: openssl rand -hex 32
CHECKIN_SESSION_SECRET=generate-a-random-64-hex-string-here

# ===========================================
# ALMACENAMIENTO - VERCEL BLOB (REQUERIDO para subir imágenes)
# ===========================================
# Token de lectura/escritura de Vercel Blob (usado por /api/admin/upload-image).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token

# ===========================================
# URL PÚBLICA (REQUERIDO EN PRODUCCIÓN)
# ===========================================
# URL base de la app desplegada. Usada en los links de los emails.
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# Usada por metadata/OG. Si falta, cae a un dominio hardcodeado (ver A8-05).
NEXT_PUBLIC_BASE_URL=https://your-domain.vercel.app
